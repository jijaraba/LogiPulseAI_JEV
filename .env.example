# Copy to .env and fill in, or export these in your shell.
TYPESAFE_API_KEY=apikey_replace-with-your-own
TYPESAFE_DEFAULT_MODEL=jev-latest

# Optional
LOGIPULSE_JEV_TIMEOUT=10.0

# See the calls to TypeSafe in the server console.
#   LOGIPULSE_TRACE_JEV=1      readable block per evaluation (state, questions, answers)
#   TYPESAFE_LOG_LEVEL=debug   the SDK's own raw wire dump (credentials redacted)
LOGIPULSE_TRACE_JEV=0
# TYPESAFE_LOG_LEVEL=debug
LOGIPULSE_LOG_LEVEL=INFO
LOGIPULSE_CORS_ORIGINS=*
LOGIPULSE_API_BASE=http://127.0.0.1:8000
